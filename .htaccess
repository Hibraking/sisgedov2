# --- Seguridad básica SISGEDO ---

# Bloquear acceso web a archivos sensibles (dumps, logs, backups, config, scripts)

<FilesMatch "\.(sql|log|bak|backup|ini|md|sh|old|bat)$">
Require all denied
</FilesMatch>

# Cabeceras de seguridad (protegidas por IfModule para no romper si falta el módulo)

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    # Solo por HTTPS: el navegador recuerda usar siempre HTTPS (1 año)
    Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
    # Política mínima que no rompe pantallas: sin plugins (<object>/<embed>),
    # sin cambiar la base de los enlaces y sin incrustar el sistema en otros sitios
    Header setifempty Content-Security-Policy "object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
</IfModule>

# --- Adjuntos y fotos de perfil: solo con sesión y permiso ---
# Las mismas direcciones de siempre ("docs adjs reg_doc/archivo.pdf", etc.)
# pasan por clases/archivo.php, que comprueba la sesión y que el usuario
# pueda ver ese documento. Así ningún enlace existente cambia.
# (Si mod_rewrite faltara, el .htaccess de cada carpeta niega el acceso.)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^docs\ adjs\ reg_doc/([^/]+)$ clases/archivo.php?c=reg&f=$1 [B,L,QSD]
    RewriteRule ^docs\ adjs\ docs_emitidos/([^/]+)$ clases/archivo.php?c=emi&f=$1 [B,L,QSD]
    RewriteRule ^images/perfiles/([^/]+)$ clases/archivo.php?c=perfil&f=$1 [B,L,QSD]
</IfModule>

# Bloquear el error_log clásico de cPanel si reaparece

<Files "error_log">
Require all denied
</Files>

# No listar el contenido de las carpetas

Options -Indexes

# No exponer la versión de PHP/Apache en las cabeceras

ServerSignature Off

# --- Rendimiento ---

# Comprimir texto (HTML, CSS, JS, JSON, SVG) antes de enviarlo: ~70% menos peso
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/x-javascript application/json image/svg+xml
</IfModule>

# Caché del navegador (30 días) para imágenes, fuentes, CSS y JS.
# Los CSS/JS propios se piden con "?v=<fecha de modificación>" (ver las vistas):
# cuando un archivo cambia, cambia su dirección y el navegador descarga el nuevo
# al instante. Así no se vuelven a pedir en cada pantalla (antes: ~8 viajes al
# servidor por página).
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 30 days"
    ExpiresByType text/javascript "access plus 30 days"
    ExpiresByType application/javascript "access plus 30 days"
    ExpiresByType application/x-javascript "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/gif "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/x-icon "access plus 30 days"
    ExpiresByType font/woff2 "access plus 30 days"
    ExpiresByType font/woff "access plus 30 days"
    ExpiresByType application/font-woff "access plus 30 days"
    ExpiresByType application/vnd.ms-fontobject "access plus 30 days"
    ExpiresByType font/ttf "access plus 30 days"
</IfModule>
