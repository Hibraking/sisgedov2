# --- Seguridad básica SISGEDO ---

# Bloquear acceso web a archivos sensibles (dumps, logs, backups, config, scripts)

<FilesMatch "\.(sql|log|bak|backup|ini|md|sh|old|bat)$">
Require all denied
</FilesMatch>

# Cabeceras de seguridad (protegidas por IfModule para no romper si falta el módulo)

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Bloquear el error_log clásico de cPanel si reaparece

<Files "error_log">
Require all denied
</Files>

# No listar el contenido de las carpetas

Options -Indexes

# No exponer la versión de PHP/Apache en las cabeceras

ServerSignature Off

# --- Rendimiento ---

# Comprimir texto (HTML, CSS, JS, JSON, SVG) antes de enviarlo: ~70% menos peso
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/x-javascript application/json image/svg+xml
</IfModule>

# Caché del navegador para archivos que casi nunca cambian (imágenes y fuentes).
# CSS y JS no se cachean a largo plazo para que las actualizaciones se vean al instante.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/gif "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/x-icon "access plus 30 days"
    ExpiresByType font/woff2 "access plus 30 days"
    ExpiresByType font/woff "access plus 30 days"
    ExpiresByType application/font-woff "access plus 30 days"
    ExpiresByType application/vnd.ms-fontobject "access plus 30 days"
    ExpiresByType font/ttf "access plus 30 days"
</IfModule>
