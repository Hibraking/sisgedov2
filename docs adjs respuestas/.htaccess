# Carpeta de adjuntos: NUNCA ejecutar código aquí, solo servir archivos.
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .phar .cgi .pl .py .asp .aspx .jsp .sh
RemoveType .php .phtml .php3 .php4 .php5 .php7 .phar

<FilesMatch "\.(php|phtml|php3|php4|php5|php7|phar|cgi|pl|py|asp|aspx|jsp|sh|htaccess)$">
    SetHandler none
    ForceType text/plain
    Require all denied
</FilesMatch>

php_flag engine off
